{
    "name": "jsdecena/laracom",
    "description": "Laravel powered e-commerce",
    "keywords": ["e-commerce", "ecommerce", "shopping-cart", "laravel", "laracom", "laravel-ecommerce", "shop", "laravel5", "framework", "package"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "barryvdh/laravel-dompdf": "^0.9.0",
        "binarytorch/larecipe": "^2.0",
        "doctrine/dbal": "^3.0",
        "fideloper/proxy": "^4.4",
        "guzzlehttp/guzzle": "^7.0",
        "jsdecena/baserepo": "^1.0",
        "jsdecena/mcpro": "^1.1",
        "kalnoy/nestedset": "^6.0",
        "laravel/cashier": "^13.0",
        "laravel/framework": "^8.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.4",
        "livepixel/mercado-pago": "^1.0",
        "nicolaslopezj/searchable": "^1.13",
        "paypal/rest-api-sdk-php": "*",
        "santigarcor/laratrust": "^6.0",
        "shippo/shippo-php": "^2.0",
        "xenon/shoppingcart": "*"
    },
    "require-dev": {
        "mockery/mockery": "^1.3",
        "phpunit/phpunit": "^9.0",
        "laravel/sail": "^1.0",
        "filp/whoops": "^2.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/helper.php"
        ],
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
